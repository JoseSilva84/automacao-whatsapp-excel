# auto, gemini ou openai.
AI_PROVIDER=gemini

# Gemini online. Crie uma chave no Google AI Studio.
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI continua disponivel como alternativa, se quiser usar depois.
OPENAI_API_KEY=

# Nome do chat do WhatsApp onde voce salva mensagens para si mesmo.
# Em muitos celulares aparece como "Voce", "You" ou seu proprio nome.
WHATSAPP_SELF_CHAT_NAME=Voce
WAHA_SESSION_NAME=agenda-whatsapp
# No ZPRO, aceite apenas mensagens enviadas pelo proprio numero conectado.
ZPRO_FROM_ME_ONLY=true
# Opcional: numero conectado no ZPRO, apenas digitos com DDI+DDD.
# Use para aceitar somente mensagens enviadas para o seu proprio chat.
ZPRO_SELF_NUMBER=
# API do ZPRO para enviar os lembretes pelo canal Baileys conectado.
ZPRO_INTEGRATION_URL=
ZPRO_API_BASE_URL=
ZPRO_API_TOKEN=
ZPRO_CHANNEL_ID=9
# Ajuste se sua instalacao usar outra rota. Use {channelId} como marcador do canal.
ZPRO_SEND_TEXT_PATH=
WEBHOOK_SECRET=troque_esse_segredo
PORT=3000

# Timezone usado para interpretar datas sem fuso explicito.
TIMEZONE=America/Fortaleza

# Google Calendar fica desligado por padrao durante os testes.
GOOGLE_CALENDAR_ENABLED=false
# Google Calendar: use "primary" para o calendario principal quando ativar.
GOOGLE_CALENDAR_ID=primary

# Google Sheets online. Se ficar vazio, a automacao grava apenas no arquivo Excel local.
# GOOGLE_SPREADSHEET_ID=10AWPWVv9AEkG4MxUQNWS4CjmN3zAoHnU2X_NMn7wtMs
# GOOGLE_SPREADSHEET_ID=1h5AttDoWSqXoq5HqKDgfcUOn-J25rvBJXN6n9M47bFI

GOOGLE_SPREADSHEET_ID=1lo0Nd_6eFMsUxgY5gCq3eZjjnSy0OJe1
GOOGLE_SHEET_NAME=Agendamentos

# Agenda pessoal no Google Sheets. Compartilhe a planilha com o e-mail da service account.
AGENDA_REMINDER_ENABLED=true
AGENDA_REMINDER_MINUTES_BEFORE=15
AGENDA_REMINDER_CHECK_INTERVAL_SECONDS=60

AGENDA_REMINDER_SHEET_RANGE=A1:ZZ80
AGENDA_REMINDER_SENT_FILE=agenda-reminders-sent.json

# No Coolify, use GOOGLE_SERVICE_ACCOUNT_JSON com o conteudo completo do JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Em teste local, pode usar o arquivo abaixo.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Arquivo Excel local gerado/atualizado automaticamente.
EXCEL_FILE=agendamentos.xlsx

# Se true, nao envia para Google Calendar/Sheets; apenas mostra o que seria feito.
DRY_RUN=false
ZPRO_API_TOKEN=0c7a60f619e0f45ffaac7a9ae9bae7726e50c74a42723cc01a45b74f059083f7